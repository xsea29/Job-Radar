# JobRadar server configuration (copy to .env; never commit real values)

# REQUIRED. Random string, at least 32 chars:  openssl rand -base64 48
JWT_SECRET=

# Database. Omit for a local on-disk database (.data/pglite); set for production PostgreSQL.
# DATABASE_URL=postgres://jobradar:password@localhost:5432/jobradar

# Browser/app origins allowed to call the API (comma-separated, or *).
# Web app + Android (Capacitor https scheme) + iOS (Capacitor scheme):
CORS_ORIGIN=https://your-app.example.com,https://localhost,capacitor://localhost

# Optional: enables GET|POST /v1/cron/scan (starts the scanner on demand, for external schedulers).
# 16+ characters; unset = endpoint disabled.  openssl rand -hex 24
CRON_SECRET=
# A repeat trigger inside this many minutes is a no-op (protects the job boards)
CRON_SLOT_MINUTES=10

# Scheduler
DAILY_AT=06:00
TIMEZONE=Asia/Kolkata
REFRESH_EVERY_MINUTES=60

# What to collect
BOARDS_FILE=config/boards.verified.json
TARGET_ROLE=fullstack
TARGET_YEARS=4

PORT=8787
